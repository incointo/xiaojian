{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TickNest",
  "version": "0.1.2",
  "identifier": "com.aakash.ticknest",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TickNest",
        "width": 360,
        "height": 557,
        "additionalBrowserArgs": "--disable-features=TouchpadOverscrollHistoryNavigation,OverscrollHistoryNavigation",
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "sidebarImage": "icons/installer-sidebar.bmp",
        "headerImage": "icons/installer-header.bmp"
      },
      "wix": {
        "dialogImagePath": "icons/installer-dialog.bmp",
        "bannerPath": "icons/installer-banner.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
