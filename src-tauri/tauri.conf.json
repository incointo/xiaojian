{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小笺",
  "version": "0.1.8",
  "identifier": "com.xiaojian.todo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "小笺",
        "width": 360,
        "height": 300,
        "additionalBrowserArgs": "--disable-features=TouchpadOverscrollHistoryNavigation,OverscrollHistoryNavigation",
        "decorations": false,
        "minWidth": 340,
        "minHeight": 300,
        "resizable": true,
        "alwaysOnTop": true,
        "transparent": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' asset: http://asset.localhost",
        "img-src": "'self' asset: http://asset.localhost data:",
        "script-src": "'self'",
        "style-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
